#!/usr/bin/env bash
# Power menu: a compact, centred row of five cards on the focused monitor.
# Running it again while open closes it.

if pgrep -x wlogout >/dev/null; then
	pkill -x wlogout
	exit 0
fi

CARD_W=150 # logical px
CARD_H=170
GAP=16
N=5

# Focused monitor size in logical pixels
read -r W H < <(hyprctl -j monitors | jq -r '.[] | select(.focused) | "\(.width / .scale | floor) \(.height / .scale | floor)"')

ROW_W=$((N * CARD_W + (N - 1) * GAP))
LR=$(((W - ROW_W) / 2))
TB=$(((H - CARD_H) / 2))
((LR < 0)) && LR=0
((TB < 0)) && TB=0

CSS="$HOME/.config/wlogout/style.css"

# Wallpaper colours when waybar-wal is on (same palette as the bar)
WAL_COLORS="$HOME/.cache/wal/colors.json"
if [[ -f ${XDG_STATE_HOME:-$HOME/.local/state}/waybar-wal-enabled && -f $WAL_COLORS ]]; then
	WAL_CSS="${XDG_CACHE_HOME:-$HOME/.cache}/wlogout/style-wal.css"
	python3 -I "$HOME/.config/hypr/scripts/wal_waybar_css.py" "$WAL_COLORS" "$CSS" "$WAL_CSS" &&
		CSS=$WAL_CSS
fi

exec wlogout --protocol layer-shell -b "$N" -c "$GAP" -r "$GAP" \
	-T "$TB" -B "$TB" -L "$LR" -R "$LR" -C "$CSS"
