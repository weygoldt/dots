#!/usr/bin/env bash
# Theme apps from the pywal palette; called by waybar-wal (on/apply/off).
#   wal-apps apply     Qt/KDE colour scheme, GTK (adw-gtk3 + colours), Hyprland border
#   wal-apps restore   put the previous qt6ct/GTK settings and border back
#
# Qt and GTK apps pick up the colours when they (re)start; Hyprland changes live.
# kitty deliberately keeps its own theme: wal palettes are too low-contrast
# for a terminal.

STATE=${XDG_STATE_HOME:-$HOME/.local/state}/wal-apps
SCRIPTS=$HOME/.config/hypr/scripts
WAL_JSON=$HOME/.cache/wal/colors.json

QT6CT=$HOME/.config/qt6ct/qt6ct.conf
WAL_SCHEME=$HOME/.local/share/color-schemes/Wal.colors

# GTK settings live in several places; all are saved before the first change
GTK_THEME=adw-gtk3-dark
GTK_FILES=(
	"$HOME/.config/gtk-3.0/settings.ini"
	"$HOME/.config/gtk-4.0/settings.ini"
	"$HOME/.config/gtk-3.0/gtk.css"
	"$HOME/.config/gtk-4.0/gtk.css"
	"$HOME/.local/share/nwg-look/gsettings" # re-applied by `nwg-look -a` at login
)

mkdir -p "$STATE"

qt_set() { # key value
	[[ -f $QT6CT ]] || return 0
	sed -i "s|^$1=.*|$1=$2|" "$QT6CT"
}

apply() {
	[[ -f $WAL_JSON ]] || { echo "wal-apps: run wal first" >&2; return 1; }

	# Qt / KDE: template = the scheme qt6ct used before wal took over
	if [[ -f $QT6CT && ! -f $STATE/qt6ct.orig ]]; then
		grep -E '^(color_scheme_path|custom_palette)=' "$QT6CT" >"$STATE/qt6ct.orig"
	fi
	local template
	template=$(sed -n 's/^color_scheme_path=//p' "$STATE/qt6ct.orig" 2>/dev/null)
	[[ $template == *.colors && -f $template ]] || template=/usr/share/color-schemes/BreezeDark.colors

	local accent
	accent=$(python3 -I "$SCRIPTS/wal_kde_colors.py" "$WAL_JSON" "$template" "$WAL_SCHEME") || return 1
	qt_set color_scheme_path "$WAL_SCHEME"
	qt_set custom_palette true

	gtk_apply

	# Hyprland: active border in the accent colour
	hyprctl eval "hl.config({ general = { col = { active_border = \"rgba(${accent#\#}cc)\" } } })" >/dev/null
}

gtk_apply() {
	local f i
	if [[ ! -d $STATE/gtk.orig ]]; then
		mkdir -p "$STATE/gtk.orig"
		for i in "${!GTK_FILES[@]}"; do
			[[ -f ${GTK_FILES[$i]} ]] && cp -p "${GTK_FILES[$i]}" "$STATE/gtk.orig/$i"
		done
		gsettings get org.gnome.desktop.interface gtk-theme >"$STATE/gtk.orig/gsettings-theme"
	fi

	# Theme: only adw-gtk3 understands the libadwaita colour names on GTK3
	if [[ -d /usr/share/themes/$GTK_THEME ]]; then
		for f in "${GTK_FILES[0]}" "${GTK_FILES[1]}"; do
			[[ -f $f ]] || continue
			if grep -q '^gtk-theme-name=' "$f"; then
				sed -i "s|^gtk-theme-name=.*|gtk-theme-name=$GTK_THEME|" "$f"
			else # plain GTK4 apps only follow the theme when it is named here
				sed -i "/^\[Settings\]/a gtk-theme-name=$GTK_THEME" "$f"
			fi
		done
		sed -i "s|^gtk-theme=.*|gtk-theme=$GTK_THEME|" "${GTK_FILES[4]}" 2>/dev/null
		gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME"
	fi

	# Colours: generated block first, then whatever the user had
	local css v
	for i in 2 3; do
		f=${GTK_FILES[$i]}
		v=$((i + 1)) # index 2 -> GTK3, 3 -> GTK4
		css=$(python3 -I "$SCRIPTS/wal_gtk_css.py" "$WAL_JSON" /dev/stdout "$v") || return 1
		mkdir -p "${f%/*}"
		{ echo "$css"; [[ -f $STATE/gtk.orig/$i ]] && cat "$STATE/gtk.orig/$i"; } >"$f"
	done
}

gtk_restore() {
	[[ -d $STATE/gtk.orig ]] || return 0
	local i
	for i in "${!GTK_FILES[@]}"; do
		if [[ -f $STATE/gtk.orig/$i ]]; then
			cp -p "$STATE/gtk.orig/$i" "${GTK_FILES[$i]}"
		else
			rm -f "${GTK_FILES[$i]}" # did not exist before
		fi
	done
	gsettings set org.gnome.desktop.interface gtk-theme "$(tr -d "'" <"$STATE/gtk.orig/gsettings-theme")"
	rm -rf "$STATE/gtk.orig"
}

restore() {
	if [[ -f $STATE/qt6ct.orig ]]; then
		while IFS='=' read -r key val; do qt_set "$key" "$val"; done <"$STATE/qt6ct.orig"
		rm -f "$STATE/qt6ct.orig"
	fi

	gtk_restore

	hyprctl reload config-only >/dev/null # border back to settings.lua
}

case $1 in
apply) apply ;;
restore) restore ;;
*)
	sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
	exit 1
	;;
esac
