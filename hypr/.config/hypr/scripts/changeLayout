#!/usr/bin/env bash
# Toggle between the dwindle and master layouts.
# Hyprland's Lua config rejects `hyprctl keyword`, so options are set via eval.
# Focus binds (SUPER+hjkl) are directional and work in both layouts.

LAYOUT=$(hyprctl -j getoption general:layout | jq -r '.str')

case $LAYOUT in
master) NEW=dwindle ;;
*) NEW=master ;;
esac

hyprctl eval "hl.config({ general = { layout = \"$NEW\" } })" >/dev/null &&
	notify-send -t 1500 "Layout: $NEW"
