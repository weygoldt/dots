#!/usr/bin/env bash

CONFIG="$HOME/.config/hypr/waybar/config.jsonc"

# style.css + wallpaper palette (waybar-wal) + SFW overlay (sfw), see waybar-style
STYLE=$("$HOME/.config/hypr/scripts/waybar-style")

if [[ ! $(pidof waybar) ]]; then
	waybar --bar main-bar --log-level error --config "$CONFIG" --style "$STYLE"
fi
