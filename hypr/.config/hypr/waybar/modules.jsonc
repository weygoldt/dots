{
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-number": true,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 60,
    "separate-outputs": true
  },
  "cpu": {
    "format": "<span alpha='55%'>CPU</span> {usage}%",
    "interval": 2,
    "states": {
      "warning": 70,
      "critical": 90
    }
  },
  "memory": {
    "format": "<span alpha='55%'>RAM</span> {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "<span alpha='55%'>TEMP</span> {temperatureC}°C",
    "interval": 5
  },
  "custom/gpu-usage": {
    "exec-if": "command -v nvidia-smi",
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | awk '{printf \"%d\", $1}'",
    "format": "<span alpha='55%'>GPU</span> {}%",
    "interval": 2,
    "tooltip": false
  },
  "custom/gpu-ram": {
    "exec-if": "command -v nvidia-smi",
    "exec": "nvidia-smi --query-gpu=utilization.memory --format=csv,noheader,nounits | awk '{printf \"%d\", $1}'",
    "format": "<span alpha='55%'>VRAM</span> {}%",
    "interval": 2,
    "tooltip": false
  },
  "custom/spotify": {
    "exec": "/usr/bin/python3 ~/.config/hypr/scripts/mediaplayer.py --player spotify",
    "format": "{}  ",
    "return-type": "json",
    "max-length": 50,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "disk#root": {
    "path": "/",
    "format": "<span alpha='55%'>ROOT</span> {percentage_used}%",
    "interval": 30,
    "tooltip-format": "{used} / {total} used on {path}"
  },
  "disk#home": {
    "path": "/home",
    "format": "<span alpha='55%'>HOME</span> {percentage_used}%",
    "interval": 30,
    "tooltip-format": "{used} / {total} used on {path}"
  },
  "battery": {
    "interval": 10,
    "full-at": 100,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": "{icon} Full",
    "format-alt": "{icon} {time}",
    "format-icons": [
      " ",
      " ",
      " ",
      " ",
      " "
    ],
    "format-time": "{H}h {M}min",
    "tooltip-format": "{timeTo} · {power:0.1f} W"
  },
  "network": {
    "interval": 10,
    "format-wifi": " ",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": "󰤭",
    "format-disabled": "󰤭",
    "format-alt": " {bandwidthUpBits} ·  {bandwidthDownBits}",
    "tooltip-format-wifi": " {essid} ({signalStrength}%) · {ipaddr}",
    "tooltip-format-ethernet": "󰈀 {ifname} · {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click-right": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon} {volume}% {format_source}",
    "format-muted": " Mute {format_source}",
    "format-bluetooth": " {volume}% {format_source}",
    "format-bluetooth-muted": " Mute {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "{desc}",
    "scroll-step": 5.0,
    "on-click": "pamixer -t",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "~/.config/hypr/scripts/volume --inc",
    "on-scroll-down": "~/.config/hypr/scripts/volume --dec",
    "smooth-scrolling-threshold": 1
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󱩏",
      "󱩑",
      "󱩔",
      "󱩖"
    ],
    "on-scroll-up": "~/.config/hypr/scripts/brightness --inc",
    "on-scroll-down": "~/.config/hypr/scripts/brightness --dec",
    "smooth-scrolling-threshold": 1
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": " <span foreground='#eb6f92'><sup></sup></span>",
      "none": "",
      "dnd-notification": " <span foreground='#eb6f92'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": " <span foreground='#eb6f92'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": " <span foreground='#eb6f92'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "clock": {
    "format": "<span alpha='55%'>{0:%a}</span> {0:%d %b  %H:%M}",
    "format-alt": "{:%R 󰃭 %d·%m·%y}",
    "interval": 30,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ebbcba'><b>{}</b></span>",
        "weekdays": "<span color='#f6c177'><b>{}</b></span>",
        "today": "<span color='#eb6f92'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "group/stats": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "temperature",
      "memory",
      "custom/gpu-usage",
      "custom/gpu-ram"
    ]
  },
  "group/storage": {
    "orientation": "horizontal",
    "modules": [
      "disk#root",
      "disk#home",
      "battery"
    ]
  },
  "group/controls": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "pulseaudio",
      "backlight"
    ]
  },
  "group/notify": {
    "orientation": "horizontal",
    "modules": [
      "custom/notification",
      "tray"
    ]
  },
  "custom/power": {
    "format": "",
    "tooltip-format": "Power menu",
    "on-click": "~/.config/hypr/scripts/wlogout"
  },
  "custom/sfw": {
    "exec": "[ -f ~/.local/state/sfw-mode ] && echo '•' || true",
    "interval": "once",
    "signal": 9,
    "tooltip": false
  },
  "group/time": {
    "orientation": "horizontal",
    "modules": [
      "clock",
      "custom/sfw"
    ]
  }
}
