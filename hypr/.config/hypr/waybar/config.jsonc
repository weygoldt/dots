{
  "include": "~/.config/hypr/waybar/modules.jsonc",
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "height": 0,
  "position": "bottom",
  "spacing": 0,
  "fixed-center": true,

  "modules-left": ["hyprland/workspaces", "group/stats"],
  "modules-center": ["hyprland/window", "custom/spotify"],
  "modules-right": ["group/storage", "group/controls", "group/notify", "group/time", "custom/power"]
}
