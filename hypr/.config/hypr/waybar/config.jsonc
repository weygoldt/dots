{
  "include": "~/.config/hypr/waybar/modules.jsonc",
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "height": 0,
  "position": "bottom",
  "spacing": 0,
  "fixed-center": true,

  "modules-left": ["hyprland/workspaces", "cpu", "temperature", "memory", "custom/gpu-usage", "custom/gpu-ram"],
  "modules-center": ["hyprland/window", "custom/spotify"],
  "modules-right": ["disk#root", "disk#home", "battery", "network", "pulseaudio", "backlight", "custom/notification", "tray", "clock"]
}
